{
  "rules": {
    ".read": true,
    "initialized": { ".write": true },
    "players": {
      "$pid": {
        ".write": true,
        "order": { ".validate": "newData.isNumber()" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "gemeente": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "geo": {
          ".validate": "newData.hasChildren(['lat', 'lon', 'label'])",
          "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lon": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "label": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "$other": { ".validate": false }
        },
        "avail": {
          "$date": { ".validate": "newData.val() === 'yes' || newData.val() === 'maybe' || newData.val() === 'no'" }
        },
        "$other": { ".validate": false }
      }
    },
    "settings": {
      "minPlayers": { ".write": true, ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
      "$other": { ".validate": false }
    },
    "carpool": {
      "$date": {
        "$pid": {
          ".write": true,
          ".validate": "newData.hasChild('role')",
          "role": { ".validate": "newData.val() === 'driver' || newData.val() === 'rider'" },
          "seats": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "with": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      }
    },
    "$other": { ".validate": false }
  }
}
